\name{RRHFD-package}
\alias{RRHFD-package}
\alias{RRHFD}
\docType{package}
\title{Robust Rolling Hotelling T-Squared Fault Detection}
\description{
A compact implementation of the adaptive robust rolling Hotelling T-squared
fault detection method used in the Stochastic Hotelling T2 project.
}
\details{
The package provides adaptive MCD alpha selection, robust rolling covariance
estimation, empirical threshold calibration, online alarms, and simple
fault-detection metrics.
}
